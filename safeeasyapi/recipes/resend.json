{
  "display": "Resend",
  "docs": "https://resend.com/docs/dashboard/api-keys/introduction",
  "env_var": "RESEND_API_KEY",
  "key_url": "https://resend.com/api-keys",
  "scopes": [],
  "service": "resend",
  "steps": [
    "Click 'Create API Key'",
    "Name it after your project (e.g. 'my-website')",
    "Leave permission at 'Sending access' unless you need 'Full access'",
    "Choose the domain it may send from, or leave unrestricted while testing",
    "Click 'Add' and copy the key — it is shown exactly once"
  ],
  "validate": {
    "auth": {
      "type": "bearer"
    },
    "expect": [
      200
    ],
    "method": "GET",
    "reject": [
      400,
      401,
      403
    ],
    "url": "https://api.resend.com/api-keys"
  }
}
